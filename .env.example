# ============================================================
# GEWEST REINAERTLAND PORTAL - ENVIRONMENT VARIABLES (.env)
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE (LibSQL / Turso)
# ------------------------------------------------------------
# Connection URL and auth token (or use file:./local.db for local SQLite)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------
# Long random secret for signing HS256 JWT cookies (min. 32 chars; 64+ recommended)
JWT_SECRET=replace_with_a_64_char_cryptographically_random_secret

# Initial admin account seeded when the users table is empty
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
# Optional: if omitted, a secure random password is generated and logged once at startup
DEFAULT_ADMIN_PASSWORD=

# Production CORS & CSRF allowed origin
ALLOWED_ORIGIN=https://reinaertland.be
PORT=3000
SESSION_INACTIVITY_HOURS=2

# ------------------------------------------------------------
# 3. GOOGLE CALENDAR TWO-WAY SYNC (Optional)
# ------------------------------------------------------------
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-bot@your-gcp-project.iam.gserviceaccount.com
# Optional public read API key (if omitted, the Service Account OAuth2 token is used)
GOOGLE_API_KEY=
# Full JSON string of your GCP Service Account key (recommended for PaaS hosting)
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# ------------------------------------------------------------
# 4. SMTP TRANSACTIONAL EMAIL (Optional)
# ------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Gewest Reinaertland <no-reply@example.com>"
